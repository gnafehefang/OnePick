:root {
  color-scheme: light;
  --bg: #f5f5f7;
  --text: #1d1d1f;
  --muted: #6e6e73;
  --line: rgba(0, 0, 0, 0.08);
  --card: rgba(255, 255, 255, 0.72);
  --blue: #0071e3;
  --blue-dark: #005bb8;
  --shadow: 0 24px 80px rgba(0, 0, 0, 0.12);
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Segoe UI", sans-serif;
  color: var(--text);
  background:
    radial-gradient(circle at 15% 0%, rgba(0, 113, 227, 0.18), transparent 32rem),
    radial-gradient(circle at 100% 18%, rgba(175, 82, 222, 0.14), transparent 30rem),
    linear-gradient(180deg, #fff, var(--bg));
}
a { color: inherit; text-decoration: none; }
.shell { width: min(1120px, calc(100% - 32px)); margin: 0 auto; padding: 22px 0 64px; }
.nav { position: sticky; top: 14px; z-index: 10; display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; margin-bottom: 80px; border: 1px solid var(--line); border-radius: 999px; background: rgba(255,255,255,0.72); backdrop-filter: blur(22px); }
.brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; letter-spacing: -0.02em; }
.brand-mark { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; color: white; background: linear-gradient(135deg, #111, #555); font-size: 13px; }
.nav-links { display: flex; gap: 18px; color: var(--muted); font-size: 14px; padding-right: 8px; }
.hero { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr); gap: 28px; align-items: center; min-height: 520px; }
.eyebrow { margin: 0 0 10px; color: var(--blue); font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
h1 { margin: 0; font-size: clamp(44px, 7vw, 82px); line-height: 0.98; letter-spacing: -0.065em; }
h2 { margin: 0; font-size: clamp(28px, 3vw, 44px); letter-spacing: -0.045em; }
h3 { margin: 12px 0 8px; font-size: 22px; letter-spacing: -0.03em; }
.lead { max-width: 680px; margin: 24px 0 0; color: var(--muted); font-size: clamp(18px, 2vw, 24px); line-height: 1.45; letter-spacing: -0.02em; }
.hero-actions { display: flex; gap: 12px; margin-top: 34px; flex-wrap: wrap; }
.button { border: 0; border-radius: 999px; padding: 13px 22px; font-size: 15px; font-weight: 700; cursor: pointer; transition: transform .18s ease, background .18s ease, box-shadow .18s ease; }
.button:hover { transform: translateY(-1px); }
.primary { color: #fff; background: var(--blue); box-shadow: 0 12px 28px rgba(0,113,227,.24); }
.primary:hover { background: var(--blue-dark); }
.ghost { background: rgba(255,255,255,.85); border: 1px solid var(--line); color: var(--text); }
.glass-card { border: 1px solid rgba(255,255,255,.7); background: var(--card); backdrop-filter: blur(30px); box-shadow: var(--shadow); }
.hero-card { position: relative; overflow: hidden; min-height: 360px; border-radius: 36px; padding: 34px; display: flex; flex-direction: column; justify-content: flex-end; }
.hero-card p { color: var(--muted); line-height: 1.6; }
.mini-title { color: var(--blue) !important; font-weight: 800; }
.orb { position: absolute; width: 220px; height: 220px; right: -48px; top: -50px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #fff, #69a8ff 34%, #6e5cff 72%); filter: saturate(120%); box-shadow: 0 28px 80px rgba(73,93,255,.38); }
.panel { margin-top: 48px; padding: 34px; border-radius: 34px; }
.section-head p:last-child { margin: 10px 0 0; color: var(--muted); line-height: 1.6; }
.parse-form { display: grid; gap: 14px; margin-top: 24px; }
textarea { width: 100%; resize: vertical; min-height: 140px; border: 1px solid var(--line); border-radius: 24px; padding: 18px; outline: none; font: inherit; font-size: 16px; background: rgba(255,255,255,.86); box-shadow: inset 0 1px 0 rgba(255,255,255,.9); }
textarea:focus { border-color: rgba(0,113,227,.42); box-shadow: 0 0 0 4px rgba(0,113,227,.12); }
.result { margin-top: 18px; border: 1px solid var(--line); background: rgba(255,255,255,.7); border-radius: 24px; padding: 18px; color: var(--muted); line-height: 1.6; }
.result strong { color: var(--text); }
.result pre { overflow: auto; padding: 14px; border-radius: 16px; background: #111; color: #f5f5f7; font-size: 13px; }
.tool-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 18px; }
.tool-card { border-radius: 30px; padding: 26px; min-height: 190px; }
.tool-card p, .roadmap li { color: var(--muted); line-height: 1.6; }
.tool-card.muted { opacity: .72; }
.icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 15px; background: rgba(0,113,227,.1); color: var(--blue); font-weight: 900; font-size: 22px; }
.roadmap { margin-top: 18px; border-radius: 34px; padding: 34px; }
.roadmap ol { margin: 18px 0 0; padding-left: 22px; }
@media (max-width: 820px) {
  .nav { margin-bottom: 42px; }
  .hero { grid-template-columns: 1fr; min-height: auto; }
  .hero-card { min-height: 280px; }
  .tool-grid { grid-template-columns: 1fr; }
}
.result-head { display: grid; grid-template-columns: 96px 1fr; gap: 16px; align-items: center; margin-bottom: 16px; }
.result-head img, .cover-placeholder { width: 96px; height: 96px; border-radius: 20px; object-fit: cover; background: linear-gradient(135deg, #111, #777); color: white; display: grid; place-items: center; font-weight: 900; }
.muted-text { color: var(--muted); margin: 6px 0 0; }
.download-list { display: grid; gap: 10px; margin: 16px 0; }
.download-item { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 14px; border: 1px solid var(--line); border-radius: 18px; background: rgba(255,255,255,.68); }
.download-item p { margin: 6px 0 0; color: var(--muted); font-size: 13px; }
.button.small { padding: 9px 14px; font-size: 13px; white-space: nowrap; }
details { margin-top: 14px; }
summary { cursor: pointer; color: var(--muted); }
@media (max-width: 560px) { .download-item { align-items: flex-start; flex-direction: column; } .result-head { grid-template-columns: 1fr; } }

.download-actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
.download-actions .ghost { box-shadow: none; }
.config-shell .nav { margin-bottom: 36px; }
.config-title { font-size: clamp(38px, 5vw, 64px); }
.config-lead { font-size: 18px; }
.status-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 24px; }
.status-card, .platform-row { border: 1px solid var(--line); border-radius: 20px; background: rgba(255,255,255,.68); padding: 16px; }
.status-card span, .platform-row p { color: var(--muted); font-size: 13px; margin: 0 0 6px; }
.status-card strong { display: block; overflow-wrap: anywhere; }
.platform-list { display: grid; gap: 10px; margin-top: 20px; }
.platform-row { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
.platform-pills { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
.pill { display: inline-flex; align-items: center; border-radius: 999px; padding: 6px 10px; font-size: 12px; font-weight: 800; }
.pill.ok { color: #057a37; background: rgba(52,199,89,.14); }
.pill.muted { color: var(--muted); background: rgba(0,0,0,.06); }
@media (max-width: 820px) { .status-grid { grid-template-columns: 1fr; } .platform-row { align-items: flex-start; flex-direction: column; } .platform-pills { justify-content: flex-start; } }

.history-list { display: grid; gap: 10px; margin-top: 20px; }
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.section-head h2 { margin: 0; }
.history-row { display: flex; align-items: center; justify-content: space-between; gap: 14px; border: 1px solid var(--line); border-radius: 18px; background: rgba(255,255,255,.68); padding: 14px; }
.history-row.fail { border-color: rgba(255, 59, 48, .24); background: rgba(255, 59, 48, .06); }
.history-row p { color: var(--muted); font-size: 13px; margin: 6px 0 0; overflow-wrap: anywhere; }
.history-meta { display: grid; gap: 4px; color: var(--muted); font-size: 12px; text-align: right; white-space: nowrap; }
@media (max-width: 820px) { .section-head { align-items: flex-start; flex-direction: column; } .history-row { align-items: flex-start; flex-direction: column; } .history-meta { text-align: left; white-space: normal; } }

.compact-panel { padding: 28px; }
.platform-list.mini { grid-template-columns: repeat(3, 1fr); display: grid; gap: 10px; }
.platform-row.compact { padding: 12px; }
.error-card { border: 1px solid rgba(255, 59, 48, .22); border-radius: 20px; background: rgba(255, 59, 48, .06); padding: 16px; }
.error-card p { margin: 8px 0; }
@media (max-width: 900px) { .platform-list.mini { grid-template-columns: 1fr; } }

.form-actions { display: flex; gap: 12px; flex-wrap: wrap; }
.inspect-card { border: 1px solid rgba(0, 113, 227, .18); border-radius: 20px; background: rgba(0, 113, 227, .06); padding: 16px; }
.inspect-card p { overflow-wrap: anywhere; }
.inspect-card ul { color: var(--muted); line-height: 1.7; }

.mini-button { border: 1px solid var(--line); background: rgba(255,255,255,.74); border-radius: 999px; padding: 6px 10px; font-size: 12px; font-weight: 800; cursor: pointer; color: var(--text); }
.mini-button:hover { background: rgba(255,255,255,.96); }
.mini-button.danger { color: #c21d12; background: rgba(255,59,48,.08); border-color: rgba(255,59,48,.18); }
.cookie-editor { position: fixed; inset: auto 24px 24px auto; width: min(680px, calc(100vw - 48px)); max-height: calc(100vh - 48px); overflow: auto; padding: 22px; z-index: 50; transform: translateY(24px); opacity: 0; pointer-events: none; transition: .18s ease; box-shadow: 0 24px 80px rgba(0,0,0,.22); }
.cookie-editor.open { transform: translateY(0); opacity: 1; pointer-events: auto; }
.cookie-editor-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
.cookie-editor textarea { width: 100%; min-height: 260px; resize: vertical; border: 1px solid var(--line); border-radius: 18px; padding: 14px; font: 13px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; background: rgba(255,255,255,.82); color: var(--text); margin: 14px 0; box-sizing: border-box; }
@media (max-width: 820px) { .cookie-editor { inset: auto 12px 12px 12px; width: auto; } }

.cookie-help-panel { border: 1px solid rgba(0,113,227,.18); background: rgba(0,113,227,.07); border-radius: 18px; padding: 14px 16px; margin: 16px 0 12px; }
.cookie-help-panel p { color: var(--muted); margin: 6px 0 0; font-size: 13px; }
.platform-pills .mini-button[data-cookie-edit] { background: linear-gradient(135deg, #0071e3, #5ac8fa); color: white; border: 0; box-shadow: 0 8px 20px rgba(0,113,227,.22); }
.platform-pills .mini-button[data-cookie-edit]:hover { filter: brightness(1.04); }
.proxy-input {
  min-width: min(420px, 100%);
  flex: 1;
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 12px;
  background: rgba(255,255,255,.08);
  color: inherit;
  padding: 10px 12px;
  outline: none;
}
.inline-actions { align-items: center; flex-wrap: wrap; }
.proxy-input::placeholder { color: rgba(255,255,255,.45); }
