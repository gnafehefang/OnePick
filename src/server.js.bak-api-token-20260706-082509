  const expectedPassword = Buffer.from(authPassword);
  const actualPassword = Buffer.from(password);
  const userOk = expectedUser.length === actualUser.length && crypto.timingSafeEqual(expectedUser, actualUser);
  const passwordOk = expectedPassword.length === actualPassword.length && crypto.timingSafeEqual(expectedPassword, actualPassword);
