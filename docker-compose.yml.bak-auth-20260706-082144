services:
  onepick-tools:
    build: .
    container_name: onepick-tools
    restart: unless-stopped
    environment:
      - NODE_ENV=production
      - PORT=3000
      - COOKIE_DIR=/app/cookies
      - DATA_DIR=/app/data
      - HISTORY_MAX_LINES=500
      - HTTP_PROXY=http://192.168.199.5:1999
      - HTTPS_PROXY=http://192.168.199.5:1999
      - NO_PROXY=localhost,127.0.0.1,192.168.0.0/16,172.16.0.0/12,10.0.0.0/8
    volumes:
      - ./cookies:/app/cookies
      - ./data:/app/data
    ports:
      - "3877:3000"
